# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# 1) DATABASE ---------------------------------------------------------------
# Required. Without it you cannot register or sign in.
#
# Option A — local, no signup. Run `npm run db:dev` in a second terminal and
# leave it running, then use its TCP url (check `npx prisma dev ls` if the port
# differs):
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
#
# Option B — hosted, nothing to keep running. Create a project at
# https://neon.com and paste its connection string here instead:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# If `npm run db:migrate` hangs, use Neon's "unpooled" / direct string.

# 2) AUTH -------------------------------------------------------------------
# Signs the session cookie. Any long random string.
# Generate one with:  npm run generate:key
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public URL of the app. Keep as-is for local development.
AUTH_URL="http://localhost:3000"

# 3) CREDENTIAL ENCRYPTION --------------------------------------------------
# Encrypts the game-account logins before they touch the database (AES-256-GCM).
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate one with:  npm run generate:key
#
# !! WARNING !! If you lose or change this key, every credential already stored
# becomes permanently unreadable. Back it up somewhere safe and never commit it.
CREDENTIALS_ENCRYPTION_KEY="replace-me-with-64-hex-characters"

# 4) YOUR FEE ---------------------------------------------------------------
# Middleman commission in basis points: 1 bp = 0.01%, so 500 = 5%.
# Taken out of the seller's payout; the buyer always pays the agreed price.
# Set to 0 to take no fee. The rate is copied onto each deal when it is created,
# so changing this never alters a deal already in progress.
DEFAULT_FEE_BPS="500"

# 5) PAYMENT WEBHOOKS -------------------------------------------------------
# Only needed if you switch a payment method to "automatic" at
# /admin/payment-methods. It signs incoming webhooks — without it, anyone who
# discovers the webhook URL could mark any deal as paid.
# Generate one with:  npm run generate:key
PAYMENTS_WEBHOOK_SECRET="replace-me-with-a-long-random-string"
