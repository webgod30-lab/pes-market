// PES Escrow — database schema
//
// This is NOT a marketplace. There is no shopfront, no browsing, no search.
// Two people have already agreed to trade accounts somewhere else (Discord,
// WhatsApp, ...). They come here only to execute that swap safely, with the
// admin as the trusted third party.
//
//   one party opens a Deal  →  sends the invite code to the other party
//   →  BOTH parties deposit their account credentials (encrypted)
//   →  ADMIN verifies both accounts still work
//   →  ADMIN approves delivery  →  each side receives the other's login
//   →  both claim (change email + password) and confirm
//   →  the deal completes
//                └── dispute freezes everything
//
// No money changes hands between the two parties, and the site takes no
// percentage: a swap has no price to take a cut of. The only money in the
// system flows one way — out, to promoters. See ReferralEarning.
//
// A Deal is one trade: it carries both accounts and the escrow state. There is
// no separate "listing", because nothing is ever advertised.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// In Prisma 7 the connection URL no longer lives here. Migrations read it from
// `datasource.url` in prisma.config.ts; the runtime client gets it from the
// driver adapter in src/lib/prisma.ts. Both read DATABASE_URL from .env.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Account-level role. Being a buyer or a seller is a per-deal position, not a
/// property of the person: the same user can sell an account this week and buy
/// one next week.
///
/// "promoter" is the one exception, and it exists because the site is otherwise
/// closed: you need a code to register, so somebody who wants to promote but
/// knows nobody has no way in. They apply at /promote, an admin approves, and
/// they get an account that can share a code and collect earnings but cannot
/// open or join a deal. They were let in to advertise, not to trade, and the
/// deal actions enforce that rather than merely hiding the buttons.
enum Role {
  user
  promoter
  admin
}

/// Where an application to become a promoter has got to.
enum PromoterApplicationStatus {
  pending
  approved
  rejected
}

/// Which position a user holds in a given deal.
enum DealSide {
  seller
  buyer
}

/// What the buyer gives in return.
///
/// "swap" is account-for-account — both sides deposit, nobody pays. It is the
/// only kind that can be created now.
///
/// "cash" is the retired flow, where the seller deposited an account and the
/// buyer paid money. The variant is kept so deals closed under it still read
/// correctly in the admin console and in someone's trade history; nothing
/// writes it any more. Deleting it would rewrite the history of real trades.
enum TradeKind {
  cash
  swap
}

/// The escrow lifecycle. Money and credentials only ever move on an admin
/// action — never automatically.
enum DealStatus {
  awaiting_counterparty // created; the other party has not joined yet
  awaiting_credentials // both parties in; seller must deposit the account
  awaiting_payment // account deposited; buyer must pay
  payment_submitted // buyer sent proof; admin has not confirmed it yet
  admin_verifying // payment confirmed and held; admin checks the account
  credentials_released // admin approved delivery; buyer can read the login
  claiming // buyer is changing the email/password to take ownership
  completed // buyer confirmed; funds released to seller
  disputed // frozen, admin case open
  refunded // buyer refunded
  cancelled // abandoned before payment
}

/// How money moves. In practice this is now only ever a promoter payout —
/// nothing on this service takes a payment any more.
///
/// `gift_card` exists because a large share of the people best placed to
/// promote this are under 18 or unbanked, and every other rail here assumes
/// otherwise: PayPal requires 18+, so does a KYC'd exchange, and a bank
/// transfer requires a bank. A Steam or Google Play code costs nothing to send,
/// needs no account anywhere, and is something a gaming audience actually
/// wants. It is the only option that works for the youngest promoters at all.
enum PaymentMethod {
  crypto
  card
  bank_transfer
  gift_card
}

enum DisputeStatus {
  open
  under_review
  resolved_buyer // decided for the buyer (refund)
  resolved_seller // decided for the seller (payout)
  cancelled // withdrawn
}

enum WithdrawalStatus {
  requested // seller asked; the money is reserved but not gone
  sent      // admin transferred it
  rejected  // admin declined; the money returns to the balance
  cancelled // seller pulled the request before it was sent
}

enum PaymentIntentStatus {
  pending // created, waiting for the provider to tell us it settled
  confirmed // provider confirmed; funds are with us
  failed // provider says it failed
  expired // never completed in time
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  displayName  String
  role         Role   @default(user)

  // --- referral / promotion ---
  //
  // Every account is a promoter. There is no separate application or role:
  // "everyone can promote the site" is the whole design, so the code is minted
  // at sign-up and the only thing that varies is whether anyone uses it.

  /// The code this user hands out, e.g. "PES-7F3K9Q". Unique, and never
  /// reissued — an old link in a Discord message must keep crediting the same
  /// person years later.
  referralCode String @unique

  /// The promoter whose code was pasted at sign-up.
  ///
  /// Nullable only because the very first account has nobody above it: a
  /// required column would make the site impossible to bootstrap, and any
  /// admin seeded before the referral system existed has no promoter either.
  /// Registration itself rejects a missing code, so no account created through
  /// the form can land here with null.
  referredById String?

  /// SetNull, not Cascade. Deleting a promoter must not delete the people they
  /// introduced along with every deal those people were part of.
  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referrals")

  referralEarnings ReferralEarning[] @relation("EarningPromoter")
  /// Credits generated BY this user's completed deals, paid to their promoter.
  referralCredits  ReferralEarning[] @relation("EarningTrader")

  /// Set only on an account created by approving an application at /promote.
  promoterApplication  PromoterApplication?  @relation("ApplicationAccount")
  applicationsReviewed PromoterApplication[] @relation("ApplicationReviewer")

  /// The payout method they picked, carried over from their application.
  ///
  /// A default for the withdraw form, not a commitment — it is re-chosen on
  /// every request, because the destination is typed fresh every time and a
  /// stored one is an account compromise away from redirecting a payout.
  preferredPayoutMethod PaymentMethod?

  // Moderation (phase 5)
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  banReason String?

  /// TOTP shared secret, encrypted at rest with the same key as the account
  /// credentials. Present but with totpEnabledAt null means enrolment was
  /// started and never confirmed, which grants nothing.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// The last time step accepted for this account. A code is refused if its
  /// step is not newer, so someone who sees a code over your shoulder cannot
  /// replay it in the seconds it remains otherwise valid.
  totpLastStep  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recoveryCodes RecoveryCode[]
  withdrawals   Withdrawal[]   @relation("WithdrawalPromoter")
  withdrawalsDecided Withdrawal[] @relation("WithdrawalDecider")

  // Deals, from either side
  dealsCreated  Deal[] @relation("DealCreator")
  dealsAsSeller Deal[] @relation("DealSeller")
  dealsAsBuyer  Deal[] @relation("DealBuyer")

  // Admin actions
  confirmedPayments   Deal[]       @relation("PaymentConfirmer")
  approvedDeliveries  Deal[]       @relation("DeliveryApprover")
  verifiedCredentials Credential[] @relation("CredentialVerifier")

  messages         Message[]
  codesRequested   TransferCode[] @relation("CodeRequester")
  codesProvided    TransferCode[] @relation("CodeProvider")
  reviewsWritten   Review[]  @relation("ReviewAuthor")
  reviewsReceived  Review[]  @relation("ReviewSubject")
  disputesOpened   Dispute[] @relation("DisputeOpener")
  disputesResolved Dispute[] @relation("DisputeResolver")

  @@index([role])
  /// Listing the people one promoter brought in.
  @@index([referredById])
}

// ---------------------------------------------------------------------------
// PromoterApplication — the way in for somebody who knows nobody
// ---------------------------------------------------------------------------

/// A request to be let in as a promoter.
///
/// Registration needs a promoter's code, which makes the site closed: the only
/// people who can join are people who already know a member. That is fine for
/// traders — a swap starts with two people who have already agreed — but it
/// means nobody can ever volunteer to advertise the service. This is that door,
/// with an admin on it.
///
/// The password is hashed at submission and never stored in the clear, the same
/// as a registration. It is collected up front so that approving is one click
/// rather than a second round of emails; a rejection clears the hash, because
/// holding credentials for somebody with no account is not something to keep.
model PromoterApplication {
  id String @id @default(cuid())

  /// What they want to be called on the site.
  displayName String
  /// Unique so the queue cannot be flooded with the same address, and so a
  /// second attempt updates the first rather than stacking behind it.
  email       String @unique

  /// bcrypt, exactly as User.passwordHash. Cleared on rejection.
  passwordHash String?

  /// Where they intend to promote — a Discord server, a YouTube channel, a
  /// group chat. Free text, and the main thing the admin decides on.
  channel String @db.Text

  /// How they want to be paid, chosen at application.
  ///
  /// Asked here rather than at the first payout for two reasons. It is the
  /// question a prospective promoter has and cannot currently find an answer
  /// to — "how do I actually get the money" — and answering it inside the form
  /// is cheaper than a page of copy. And choosing a method at the moment of
  /// applying makes the earnings concrete: it is a small commitment that costs
  /// nothing and makes the money feel real rather than theoretical.
  payoutMethod PaymentMethod?

  status PromoterApplicationStatus @default(pending)

  /// Set once approved: the account this application produced. SetNull rather
  /// than Cascade, so deleting a promoter's account leaves the record of the
  /// decision behind.
  createdUserId String? @unique
  createdUser   User?   @relation("ApplicationAccount", fields: [createdUserId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Why it was refused, or a note on the approval.
  decisionNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// ReferralEarning — $2 to a promoter, once, for a completed deal
// ---------------------------------------------------------------------------

/// The only money this service ever owes anyone.
///
/// A row is written when a deal completes, for each side of it, and is paid to
/// that side's promoter — never to the trader. Two people introduced by two
/// different promoters therefore produce two rows; if one promoter introduced
/// both, they earn twice from the same deal, which is correct: they brought in
/// both halves of it.
///
/// A row, not a running total on User. The same reasoning as Withdrawal: a
/// stored balance is a number that drifts away from the events that produced
/// it, and reconciling it later is guesswork. Here the events ARE the balance.
///
/// `amountCents` is snapshotted rather than read from config at payout time, so
/// changing the rate later never silently revalues what someone already earned.
model ReferralEarning {
  id String @id @default(cuid())

  /// Who gets paid.
  promoterId String
  /// Whose completed deal produced it. Kept so a promoter can see the credit
  /// broken down by the person who earned it for them.
  traderId   String
  dealId     String

  amountCents Int    @default(200)
  currency    String @default("USD")

  createdAt DateTime @default(now())

  promoter User @relation("EarningPromoter", fields: [promoterId], references: [id], onDelete: Cascade)
  trader   User @relation("EarningTrader", fields: [traderId], references: [id], onDelete: Cascade)
  deal     Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// The guard that makes crediting idempotent.
  ///
  /// A deal can reach "completed" more than once in practice — a dispute is
  /// resolved, an admin forces it through, a request is retried. Without this
  /// the promoter would be paid again each time. Keyed on the TRADER rather
  /// than the promoter so a deal between two people with the same promoter
  /// still writes the two rows it should.
  @@unique([dealId, traderId])
  @@index([promoterId, createdAt])
}

// ---------------------------------------------------------------------------
// Deal — one trade, held in escrow
// ---------------------------------------------------------------------------

model Deal {
  id String @id @default(cuid())

  /// Short reference both parties can quote, e.g. "ESC-7F3K9Q".
  reference String @unique

  /// Secret code the creator sends to the counterparty so they can join.
  /// Single-use: cleared once accepted, so a leaked link stops working.
  inviteCode       String?   @unique
  inviteAcceptedAt DateTime?

  createdById String
  /// Which side the creator took. The other side is the one still open.
  createdSide DealSide

  /// Exactly one of these is set at creation; the other fills in on join.
  sellerId String?
  buyerId  String?

  // --- what is being traded (agreed off-site, recorded here) ---
  /// Plain description so both parties and the admin agree on the same thing.
  accountSummary String  @db.Text
  game           String  @default("eFootball")
  platform       String?
  level          Int?

  /// Always "swap" on anything created now. Rows written before the cash flow
  /// was retired keep their original value, which is why the column stays.
  tradeKind TradeKind @default(swap)

  /// Swap only: what the BUYER hands over. The seller's side is
  /// accountSummary above, so a swap carries one description per party.
  counterAccountSummary String? @db.Text

  // --- money, in integer minor units ("cents"); never floats ---
  //
  // All three are zero on every deal created now. A swap has no price, and the
  // service takes no commission from one. They are kept, rather than dropped,
  // because deals closed under the retired cash flow carry real figures here
  // and dropping the columns would erase what those people actually agreed to.
  /// What the buyer paid, on a retired cash deal. Zero on a swap.
  agreedPriceCents Int    @default(0)
  currency         String @default("USD")

  /// Retired commission rate in basis points (500 = 5%). Always 0 now.
  feeBps Int @default(0)
  /// Retired commission in cents. Always 0 now.
  feeCents Int @default(0)
  /// What the seller received on a retired cash deal. Always 0 now.
  sellerPayoutCents Int @default(0)

  status DealStatus @default(awaiting_counterparty)

  // --- payment (manual settlement; no gateway) ---
  paymentMethod        PaymentMethod?
  /// Crypto transaction hash pasted by the buyer.
  paymentTxHash        String?
  /// Card/bank reference or note pasted by the buyer.
  paymentReference     String?
  /// Exactly what the buyer was told to pay to, captured when they submitted.
  /// If the wallet address is later edited, a dispute can still show what was
  /// on screen at the time.
  paymentInstructionsSnapshot String? @db.Text
  paymentSubmittedAt   DateTime?
  paymentConfirmedAt   DateTime?
  paymentConfirmedById String?

  // --- admin verification + delivery approval ---
  verificationStartedAt DateTime?
  deliveryApprovedAt    DateTime?
  deliveryApprovedById  String?

  /// What was actually handed over, encrypted the same way as Credential.
  /// Snapshotted at release so a later edit cannot rewrite history.
  /// On both kinds of deal this is the SELLER's account — the one the buyer
  /// receives.
  deliveredCiphertext   String?   @db.Text
  /// Swap only: the buyer's account, which the seller receives. Snapshotted at
  /// the same moment and for the same reason. Null on a cash deal, where only
  /// one account changes hands.
  deliveredCounterCiphertext String? @db.Text
  credentialsReleasedAt DateTime?

  // --- buyer claim window (24-48h) ---
  confirmationDeadline DateTime?
  buyerConfirmedAt     DateTime?
  /// Swap only. A swap completes when BOTH sides confirm, so the seller needs
  /// a confirmation of their own — on a cash deal only the buyer claims.
  sellerConfirmedAt    DateTime?
  lastReminderSentAt   DateTime?

  // --- terminal states ---
  completedAt DateTime?
  refundedAt  DateTime?
  cancelledAt DateTime?

  /// The status a deal was in when a dispute froze it. Withdrawing the dispute
  /// puts it back, rather than guessing where it should resume.
  preDisputeStatus DealStatus?

  /// Set when the payout to the seller is actually sent (manual).
  payoutAt        DateTime?
  payoutReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy          User        @relation("DealCreator", fields: [createdById], references: [id])
  seller             User?       @relation("DealSeller", fields: [sellerId], references: [id])
  buyer              User?       @relation("DealBuyer", fields: [buyerId], references: [id])
  paymentConfirmedBy User?       @relation("PaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  deliveryApprovedBy User?       @relation("DeliveryApprover", fields: [deliveryApprovedById], references: [id], onDelete: SetNull)
  credentials        Credential[]
  messages           Message[]
  reviews            Review[]
  disputes           Dispute[]
  paymentIntents     PaymentIntent[]
  transferCodes      TransferCode[]
  referralEarnings   ReferralEarning[]

  @@index([status])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// PaymentMethodConfig — how the admin tells buyers to pay
// ---------------------------------------------------------------------------

/// There is no payment gateway. The admin settles by hand, so these rows are
/// simply the instructions shown to a buyer: a wallet address and network for
/// crypto, or whatever manual arrangement the admin uses for card and bank.
///
/// Deactivate rather than delete: a deal that already quoted a method should
/// still make sense afterwards.
model PaymentMethodConfig {
  id     String        @id @default(cuid())
  method PaymentMethod

  /// Shown to the buyer, e.g. "USDT (TRC-20)".
  label     String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Free text shown under the method. Supports plain line breaks.
  instructions String @db.Text

  /// When true the payment is confirmed by a provider webhook instead of the
  /// admin checking a wallet by hand. Requires `provider` to be set.
  isAutomatic Boolean @default(false)
  /// Which adapter in src/lib/payments handles it, e.g. "sandbox".
  provider    String?

  // --- crypto only ---
  walletAddress String?
  network       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// PaymentIntent — one attempt to pay a deal through a provider
// ---------------------------------------------------------------------------

/// Created when a buyer starts an automatic payment. The provider later tells us
/// what happened over a webhook.
///
/// `externalId` is unique on purpose: it is the provider's own id for the
/// payment, so a replayed or duplicated webhook updates the same row instead of
/// creating a second one and crediting the deal twice.
model PaymentIntent {
  id       String @id @default(cuid())
  dealId   String
  provider String

  externalId String @unique

  amountCents Int
  currency    String @default("USD")

  status PaymentIntentStatus @default(pending)

  /// The last thing the provider told us, kept for support. Providers are sent
  /// no card data by this app, and none is stored here.
  lastPayload String?   @db.Text
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// WebhookEvent — replay protection
// ---------------------------------------------------------------------------

/// Every webhook a provider sends has an id. Recording it, with a unique index,
/// is what makes delivery idempotent: providers retry on any non-2xx, and
/// without this a retry would confirm a payment twice.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String
  eventId  String

  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Credential — the account login, ENCRYPTED AT REST
// ---------------------------------------------------------------------------

/// One row per deal. `ciphertext` is an AES-256-GCM payload produced by
/// src/lib/crypto.ts in the format v1:<iv>:<authTag>:<data>. It decrypts to a
/// JSON object (loginEmail, loginPassword, recoveryEmail, ...).
///
/// NEVER log this, and never show it to the buyer before the admin has approved
/// delivery on the deal.
model Credential {
  id     String @id @default(cuid())
  dealId String

  /// Whose account this is. On a cash deal only the seller ever deposits, so
  /// existing rows are seller and the default keeps them that way. A swap has
  /// one row per side.
  side   DealSide @default(seller)

  ciphertext String @db.Text

  // Admin re-checks the account works before approving delivery
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  verificationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal           Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lastVerifiedBy User? @relation("CredentialVerifier", fields: [lastVerifiedById], references: [id], onDelete: SetNull)

  /// Replaces a plain unique on dealId. side is non-null with a default, so
  /// this cannot degrade into "many rows with NULL side" the way a nullable
  /// discriminator would.
  @@unique([dealId, side])
}

// ---------------------------------------------------------------------------
// TransferCode — the publisher's verification code, passed seller to buyer
// ---------------------------------------------------------------------------

/// Handing over a game account is not finished when the login changes hands.
/// Changing the email on an eFootball account makes Konami send a verification
/// code to the address currently on file — the SELLER's address. The buyer
/// physically cannot complete the transfer without it.
///
/// So this is a request the buyer raises and the seller fills in. There can be
/// several per deal, because the publisher sends a fresh code for each attempt
/// and codes expire quickly.
///
/// The code itself is encrypted: while it is live it grants access to the
/// account, so it is treated exactly like the credentials.
model TransferCode {
  id     String @id @default(cuid())
  dealId String

  /// What the buyer is stuck on, e.g. "Konami sent a code to the account email".
  requestNote   String?
  requestedById String
  requestedAt   DateTime @default(now())

  /// Null until the seller supplies it. Format matches src/lib/crypto.ts.
  ciphertext    String?   @db.Text
  providedById  String?
  providedAt    DateTime?

  deal        Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("CodeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  providedBy  User? @relation("CodeProvider", fields: [providedById], references: [id], onDelete: SetNull)

  @@index([dealId, requestedAt])
  // Finding requests nobody has answered yet.
  @@index([providedAt])
}

// ---------------------------------------------------------------------------
// Message — per-deal chat
// ---------------------------------------------------------------------------

model Message {
  id       String @id @default(cuid())
  dealId   String
  senderId String
  body     String @db.Text

  /// Admin-only note: visible in the admin case view, not to the two parties.
  isAdminNote Boolean   @default(false)
  readAt      DateTime?

  createdAt DateTime @default(now())

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

// ---------------------------------------------------------------------------
// Review — one per completed deal
// ---------------------------------------------------------------------------

/// Both sides review each other after a completed deal — one review per person
/// per deal, enforced by the composite unique below. A buyer who never pays on
/// time is as worth knowing about as a seller who hands over a dead account.
model Review {
  id        String @id @default(cuid())
  dealId    String
  authorId  String
  subjectId String

  /// Which side the *subject* was on for this deal, so a profile can show
  /// "as a seller" and "as a buyer" separately.
  subjectSide DealSide

  /// 1..5, enforced in application code.
  rating  Int
  comment String? @db.Text

  createdAt DateTime @default(now())

  deal    Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author  User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([dealId, authorId])
  @@index([subjectId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Dispute — freezes a deal and opens an admin case
// ---------------------------------------------------------------------------

/// A deal can have more than one of these over its life: a dispute may be
/// withdrawn and a new one opened later if things go wrong again. Every case is
/// kept — overwriting the previous one would destroy the evidence the admin
/// needs. Application code always works on the most recent, and refuses to open
/// a second while one is still open.
model Dispute {
  id          String @id @default(cuid())
  dealId      String
  openedById  String
  reason      String
  description String @db.Text

  status       DisputeStatus @default(open)
  resolution   String?       @db.Text
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  openedBy   User  @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dealId, createdAt])
}

// ---------------------------------------------------------------------------
// RateLimitBucket — brute-force protection for the auth routes
// ---------------------------------------------------------------------------

/// A fixed-window counter, in the database rather than in memory.
///
/// In memory would be worse than nothing here: this deploys to serverless, so
/// every instance would keep its own count and an attacker would get the limit
/// multiplied by however many instances happen to be warm.
///
/// The primary key is (key, windowStart), so an upsert with an increment is a
/// single atomic statement and two simultaneous attempts cannot both read a
/// stale count and write the same value back.
model RateLimitBucket {
  /// What is being limited, e.g. "login:ip:1.2.3.4" or "login:email:a@b.c".
  key         String
  /// Start of the window this count belongs to.
  windowStart DateTime
  count       Int      @default(0)
  /// When this row stops mattering, so old rows can be swept without knowing
  /// which limit produced them.
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// RecoveryCode — the way back in when the phone is gone
// ---------------------------------------------------------------------------

/// Single-use codes issued when two-factor is turned on.
///
/// These are not a nicety. There is no password reset on this service yet, so
/// without them a lost or wiped phone means an account — including the only
/// admin account, which approves every payout — is locked shut permanently.
///
/// Stored as bcrypt hashes, the same as passwords: a database leak must not
/// hand over a working second factor. Used codes are kept rather than deleted,
/// so the account owner can see one was spent and when.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// ---------------------------------------------------------------------------
// Withdrawal — a seller taking their balance off the site
// ---------------------------------------------------------------------------

/// A promoter asking to be paid their referral earnings.
///
/// There is deliberately no balance column anywhere. A balance stored as a
/// number is a number that can drift away from the events that produced it, and
/// reconciling it afterwards is guesswork. It is derived instead: every
/// ReferralEarning, minus everything requested or already sent. A rejected or
/// cancelled request stops counting and the money reappears, with no
/// compensating write to get wrong.
///
/// `requested` reserves the money. Without that a promoter could open two
/// requests for the same balance and be paid twice.
model Withdrawal {
  id String @id @default(cuid())

  /// Was `sellerId` when sellers were paid out for cash deals. Sellers are no
  /// longer owed anything — a swap has no money in it — so the only person who
  /// can be owed is a promoter, and the column says so.
  promoterId String

  amountCents Int
  currency    String        @default("USD")
  method      PaymentMethod

  // --- where to send it ---
  //
  // Split into named fields rather than one block of text. The admin reads
  // these while typing a transfer into a bank or a wallet, and a single
  // free-text box is where an IBAN ends up glued to an account name. Every
  // one is typed per request rather than saved to the account: a stored
  // address is one account compromise away from silently redirecting every
  // future payout.

  /// Who the money is going to. Banks and most wallets reject a transfer
  /// whose name does not match the account.
  destinationName String

  /// What it is sent to: IBAN or account number, wallet address, or the
  /// email/handle on a payment account.
  destinationAccount String

  /// Crypto only. TRC-20, ERC-20, and so on — sending USDT to the right
  /// address on the wrong network loses it.
  destinationNetwork String?

  /// Bank transfer only.
  destinationBank String?
  destinationBic  String?

  /// Card and wallet payouts: PayPal, Wise, Payoneer.
  destinationProvider String?

  status WithdrawalStatus @default(requested)

  // --- the test transaction ---
  //
  // On a promoter's first payout the admin sends a nominal amount, waits for
  // them to confirm it landed, and only then sends the balance.
  //
  // This is not ceremony. A crypto transfer to a mistyped address is gone
  // permanently, and the person who typed it will not believe it was their own
  // mistake — which turns a lost $40 into a public argument on the forum you
  // recruit from. Losing a dollar and a day is the cheaper outcome.

  /// When the admin sent the test, and its hash or reference.
  testSentAt    DateTime?
  testReference String?
  /// When the promoter confirmed it arrived. Until this is set, the balance
  /// must not be sent.
  testConfirmedAt DateTime?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  /// Transfer reference once sent, or the reason it was refused.
  note String? @db.Text

  promoter  User  @relation("WithdrawalPromoter", fields: [promoterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("WithdrawalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([promoterId, requestedAt])
  @@index([status, requestedAt])
}

// ---------------------------------------------------------------------------
// VisitCounter — how many people looked at the site this month
// ---------------------------------------------------------------------------

/// One row per calendar month, holding a running count of homepage visits.
///
/// A count, not a log. There is no row per visit, no address, no user agent and
/// no identifier of any kind kept — so there is nothing here to correlate,
/// leak or subpoena, and the privacy policy's claim that this site assigns no
/// identifier stays true.
///
/// That is also why it counts visits rather than visitors: telling two people
/// apart means marking them, and marking them is the thing being avoided.
model VisitCounter {
  /// "2026-08".
  month String @id
  views Int    @default(0)

  updatedAt DateTime @updatedAt
}
